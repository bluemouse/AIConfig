# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node (optional skill scripts)
node_modules/

# Secrets and local env
.env
.env.*
!.env.example

# Logs and temp files
*.log
*.swp
*~

# IDE (user-local; keep .cursor/ project config tracked; .github/ is generated below)
.idea/
*.sublime-*

# Skill packaging
*.skill

# Skill-creator eval and benchmark outputs
*-workspace/
benchmarks/
feedback.json
history.json
grading.json
timing.json

# Claude Code runtime
.claude/scheduled_tasks.lock

# Installed tool output (generated by install_portable_* scripts and
# tools/installer.py; not repo content). A fresh clone regenerates:
#   skills  -> python skills/skill-creator/scripts/install_portable_skill.py
#   agents  -> python skills/agent-creator/scripts/install_portable_agent.py
#   commands-> python skills/command-creator/scripts/install_portable_command.py
#   scripts -> python tools/installer.py . --scripts dev-workflow --override
#   guidelines -> python tools/installer.py . --guidelines <name> --override
.agents/
.claude/
.github/
